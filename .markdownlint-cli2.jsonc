// markdownlint-cli2 configuration.
//
// We intentionally enforce ONLY the line-length rule (MD013) at 80 columns, to
// mirror Google's internal Markdown linter. Contributions with lines longer
// than 80 characters are flagged by the internal Copybara import presubmit;
// enforcing the same limit here catches them at PR time instead. All other
// markdownlint rules are disabled so we don't impose unrelated style
// constraints on contributors.
{
  "config": {
    "default": false,
    "MD013": {
      "line_length": 80,
      // Don't flag long lines inside fenced code blocks or tables; these often
      // cannot be wrapped. Long, unbreakable tokens (e.g. URLs) are already
      // exempt by MD013's default behaviour.
      "code_blocks": false,
      "tables": false
    }
  },
  "ignores": [
    "**/node_modules/**",
    "docs/_build/**"
  ]
}
